<mxCell id="n2" value='&lt;p style="margin:0px;margin-top:3px;text-align:center;"&gt;«entity»&lt;br&gt;&lt;b&gt;Account&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:5px;"&gt;+ AccountId: long&lt;br&gt;+ CoopId: long?&lt;br&gt;+ SubjectType: SubjectType&lt;br&gt;+ DisplayName: string&lt;br&gt;+ Username: string?&lt;br&gt;+ Phone: PhoneNumber?&lt;br&gt;+ PhoneVerifiedAt: DateTime?&lt;br&gt;+ Email: string?&lt;br&gt;+ EmailVerifiedAt: DateTime?&lt;br&gt;+ PasswordHash: string&lt;br&gt;+ MustChangePassword: bool&lt;br&gt;+ TempPasswordExpiresAt: DateTime?&lt;br&gt;+ SecurityStamp: Guid&lt;br&gt;+ FailedLoginCount: short&lt;br&gt;+ LockoutUntil: DateTime?&lt;br&gt;+ StatusId: short → sys.status (ACCOUNT)&lt;br&gt;+ RowVersion: byte[]&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:5px;"&gt;+ CreateTrader(verifiedTarget, hash, name): Account&lt;br&gt;+ CreateInternal(cmd, hash): Account&lt;br&gt;+ SetPassword(hash, tempExpiresAt?)&lt;br&gt;+ RecordLoginFailure(policy, now)&lt;br&gt;+ ResetLoginFailures()&lt;br&gt;+ ApplyStatus(statusId)&lt;br&gt;+ UpdateProfile(name)&lt;br&gt;+ SetVerifiedEmail(email, now)&lt;br&gt;+ SetVerifiedPhone(phone, now)&lt;br&gt;+ RequiresPhoneVerification(): bool&lt;br&gt;+ RotateSecurityStamp()&lt;/p&gt;' style="html=1;whiteSpace=wrap;fontSize=10;verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="20" width="330" height="410" as="geometry"/></mxCell>
