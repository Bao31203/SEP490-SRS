<mxCell id="n2" value="UC-SAL-06 Hoàn tất bán hàng tại cảng – sơ đồ luồng" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="24" as="geometry"/></mxCell>
<mxCell id="st" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="659.0" y="60" width="26" height="26" as="geometry"/></mxCell>
<mxCell id="b1" value="1. Người thao tác mở đơn và lô nguồn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="116" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="b2" value="2. Người thao tác cân hàng cùng thương lái; thương lái xác nhận số cân; hệ thống lưu phiếu cân, người và thời điểm." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="186" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="b3" value="3. Người thao tác và thương lái thống nhất giá thị trường; hệ thống lưu giá và căn cứ đồng ý." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="286" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="b4" value="4. Hệ thống gửi số cân và giá đã thống nhất cho thương lái qua Zalo OA (khách không có tài khoản Zalo thì qua SMS) và ghi lần gửi (BR-26). Cảng mất mạng thì tin này được gửi khi có mạng (nhánh 5a)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="386" width="320" height="100" as="geometry"/></mxCell>
<mxCell id="b5" value="5. Lô chưa có bản công bố hiện hành thì người thao tác rà và công bố hồ sơ truy xuất ở UC-TRC-01 trước khi bàn giao (BR-14)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="516" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="b6" value="6. Hệ thống kiểm phiếu cân, giá và QR trỏ đúng bản công bố hiện hành." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="626" width="320" height="50" as="geometry"/></mxCell>
<mxCell id="b7" value="7. Người thao tác ghi người nhận, thời điểm, cảng và xác nhận bàn giao; đơn chuyển sang Đã bàn giao." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="706" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="b8" value="8. Hệ thống hiện đối chiếu mục tiêu – ước tính – số cân – bàn giao, tính kg × giá và gợi ý số tiền làm tròn lên nghìn đồng gần nhất." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="806" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="b9" value="9. Người thao tác xác nhận hoặc nhập số tiền cuối." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="916" width="320" height="50" as="geometry"/></mxCell>
<mxCell id="b10" value="10. Hệ thống tạo một giao dịch bán, biên nhận và khoản phải thu, lưu chứng từ trên dịch vụ lưu trữ đám mây, chuyển đơn Đã bàn giao → Đã chốt bán; tạo QR chuyển khoản theo chuẩn VietQR từ tài khoản ngân hàng của HTX (UC-ORG-01), số tiền và mã giao dịch, gửi kèm số tiền cho thương lái qua Zalo OA, email hoặc SMS và ghi lần gửi (BR-26); người chốt là Quản lý khu thì hệ thống báo Chủ HTX giao dịch đã chốt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="996" width="320" height="190" as="geometry"/></mxCell>
<mxCell id="en" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="658.0" y="1216" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x1a" value="1a. Bán lại hàng trả." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="922" y="114.0" width="270" height="40" as="geometry"/></mxCell>
<mxCell id="e1a" value="về bước 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=12;fillColor=#f5f5f5;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="121.0" width="92" height="30" as="geometry"/></mxCell>
<mxCell id="x5a" value="5a. Cảng mất mạng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="922" y="534.0" width="270" height="40" as="geometry"/></mxCell>
<mxCell id="e5a" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1224" y="542.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x8a" value="8a. Điều khoản đơn đã được sửa trước khi giao (UC-SAL-04 nhánh 1c)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="922" y="824.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e8a" value="về bước 9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=12;fillColor=#f5f5f5;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="831.0" width="92" height="30" as="geometry"/></mxCell>
<mxCell id="x8b" value="8b. Số cân chênh mục tiêu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="922" y="888.0" width="270" height="40" as="geometry"/></mxCell>
<mxCell id="e8b" value="về bước 9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=12;fillColor=#f5f5f5;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="893.0" width="92" height="30" as="geometry"/></mxCell>
<mxCell id="x8c" value="8c. Chủ HTX hoặc Quản lý khu phụ trách đơn xem lịch sử đơn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="922" y="942.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e8c" value="về bước 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=12;fillColor=#f5f5f5;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="947.0" width="92" height="30" as="geometry"/></mxCell>
<mxCell id="x10a" value="10a. Bấm lặp hoặc mất kết nối khi đang chốt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="922" y="1069.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e10a" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1224" y="1077.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x1b" value="1b. Bán lại hàng trả nhưng đơn mới không gắn lần trả nguồn, hoặc lượng phân bổ vượt phần hàng trả còn được bán lại." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;dashed=1;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="152" y="114.0" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="e1b" value="" style="ellipse;shape=endState;html=1;fillColor=#b85450;strokeColor=#b85450;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="106" y="122.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x3a" value="3a. Hai bên chưa thống nhất giá." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;dashed=1;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="152" y="299.0" width="270" height="40" as="geometry"/></mxCell>
<mxCell id="e3a" value="" style="ellipse;shape=endState;html=1;fillColor=#b85450;strokeColor=#b85450;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="106" y="307.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x5b" value="5b. Hồ sơ rà ở UC-TRC-01 chưa đạt khi có mạng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;dashed=1;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="152" y="534.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e5b" value="về bước 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=12;fillColor=#f5f5f5;dashed=0;" vertex="1" parent="1"><mxGeometry x="42" y="541.0" width="92" height="30" as="geometry"/></mxCell>
<mxCell id="x6a" value="6a. Bản công bố hiện hành của lô ở Cần rà lại (sau đính chính ở UC-TRC-04)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;dashed=1;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="152" y="629.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e6a" value="về bước 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=12;fillColor=#f5f5f5;dashed=0;" vertex="1" parent="1"><mxGeometry x="42" y="636.0" width="92" height="30" as="geometry"/></mxCell>
<mxCell id="x8d" value="8d. Thiếu giá hoặc số cân chốt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;dashed=1;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="152" y="824.0" width="270" height="40" as="geometry"/></mxCell>
<mxCell id="e8d" value="về bước 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=12;fillColor=#f5f5f5;dashed=0;" vertex="1" parent="1"><mxGeometry x="42" y="831.0" width="92" height="30" as="geometry"/></mxCell>
<mxCell id="x8e" value="8e. Thương lái chưa đồng ý phần chênh cân." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;dashed=1;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="152" y="878.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e8e" value="" style="ellipse;shape=endState;html=1;fillColor=#b85450;strokeColor=#b85450;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="106" y="884.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x8f" value="8f. Bán lại hàng trả nhưng chưa có số cân mới được người mua mới xác nhận." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;dashed=1;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="152" y="942.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e8f" value="" style="ellipse;shape=endState;html=1;fillColor=#b85450;strokeColor=#b85450;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="106" y="948.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x8g" value="8g. Sửa lùi số cân, nguồn hoặc biên nhận của đơn đã bàn giao." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;dashed=1;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="152" y="1006.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e8g" value="" style="ellipse;shape=endState;html=1;fillColor=#b85450;strokeColor=#b85450;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="106" y="1012.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x9a" value="9a. Số tiền nhập không phải bội số 1.000 VND." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;dashed=1;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="152" y="1070.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e9a" value="về bước 9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=12;fillColor=#f5f5f5;dashed=0;" vertex="1" parent="1"><mxGeometry x="42" y="1075.0" width="92" height="30" as="geometry"/></mxCell>
<mxCell id="n44" value="Ký hiệu: ● bắt đầu; ◉ đen = kết thúc thành công; ◉ đỏ = kết thúc do lỗi; khung trắng = bước luồng chính; khung vàng (phải) = luồng thay thế; khung đỏ nét đứt (trái) = luồng ngoại lệ; “về bước N” = quay lại bước N; “về nhánh Na” = quay lại nhánh Na. Chi tiết từng nhánh ở bảng đặc tả UC." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1276" width="1264" height="40" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="endArrow=block;endFill=1;startArrow=none;endSize=7;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="st" target="b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e4" value="" style="endArrow=block;endFill=1;startArrow=none;endSize=7;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
