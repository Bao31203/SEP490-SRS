<mxCell id="e43" value="" style="endArrow=block;endFill=1;startArrow=none;endSize=7;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#444444;exitX=0.0;exitY=0.4;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="x9a" target="e9a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="UCF-CLM-02" id="UCF-CLM-02"><mxGraphModel dx="1364" dy="686" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1364" pageHeight="686" math="0" shadow="0"><root><mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="n2" value="UC-CLM-02 Giải quyết yêu cầu chất lượng – sơ đồ luồng" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="24" as="geometry"/></mxCell>
<mxCell id="st" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="659.0" y="60" width="26" height="26" as="geometry"/></mxCell>
<mxCell id="b1" value="1. Chủ HTX mở yêu cầu và xem giao dịch gốc, số cân, bằng chứng, các điều chỉnh trước và thông tin liên hệ của thương lái (tên, số điện thoại)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="116" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="b2" value="2. Chủ HTX ghi quyết định: không điều chỉnh, giảm giá hoặc nhận trả toàn bộ đơn (chỉ khi yêu cầu là đề nghị trả hàng, đơn ở Yêu cầu trả hàng); hệ thống lưu người, thời điểm, lý do." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="226" width="320" height="100" as="geometry"/></mxCell>
<mxCell id="b3" value="3. Khi nhận trả, đơn chuyển sang Đã chấp nhận trả và hệ thống báo cho thương lái: qua Zalo OA nếu thương lái chưa có tài khoản OMTS (không có Zalo thì qua SMS); có tài khoản thì qua email, email không gửi được thì qua SMS; hệ thống ghi lần gửi gắn đơn (BR-26)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="356" width="320" height="140" as="geometry"/></mxCell>
<mxCell id="en" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="658.0" y="526" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x2a" value="2a. Quyết định giảm giá (không nhận trả hàng)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="922" y="254.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e2a" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1224" y="262.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x2b" value="2b. Chủ HTX từ chối yêu cầu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;dashed=1;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="152" y="254.0" width="270" height="40" as="geometry"/></mxCell>
<mxCell id="e2b" value="" style="ellipse;shape=endState;html=1;fillColor=#b85450;strokeColor=#b85450;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="106" y="262.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x3a" value="3a. Chủ HTX không liên lạc được thương lái hoặc hàng trả không về." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;dashed=1;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="152" y="404.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e3a" value="" style="ellipse;shape=endState;html=1;fillColor=#b85450;strokeColor=#b85450;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="106" y="412.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="n13" value="Ký hiệu: ● bắt đầu; ◉ đen = kết thúc thành công; ◉ đỏ = kết thúc do lỗi; khung trắng = bước luồng chính; khung vàng (phải) = luồng thay thế; khung đỏ nét đứt (trái) = luồng ngoại lệ; “về bước N” = quay lại bước N; “về nhánh Na” = quay lại nhánh Na. Chi tiết từng nhánh ở bảng đặc tả UC." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="586" width="1264" height="40" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="endArrow=block;endFill=1;startArrow=none;endSize=7;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="st" target="b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
