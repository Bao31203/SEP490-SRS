<mxCell id="n2" value="UC-TRC-01 Công bố hồ sơ truy xuất – sơ đồ luồng" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="24" as="geometry"/></mxCell>
<mxCell id="st" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="659.0" y="60" width="26" height="26" as="geometry"/></mxCell>
<mxCell id="b1" value="1. Người thao tác mở hồ sơ truy xuất của lô; hệ thống hiện cây nguồn, phiếu cân, giấy tờ vùng, chỉ số nước và cảnh báo thiếu liên kết." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="116" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="b2" value="2. Người thao tác duyệt từng đường nguồn bè/lối/giống và đối chiếu nội dung tiếng Việt/tiếng Anh." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="226" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="b3" value="3. Người thao tác ghi kết luận Đạt; hệ thống lưu kết luận gắn phiên bản dữ liệu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="326" width="320" height="50" as="geometry"/></mxCell>
<mxCell id="b4" value="4. Người thao tác chọn Công bố; hệ thống kiểm dữ liệu chưa đổi sau rà (đã đổi thì bản về Nháp, rà lại theo nhánh 3a) và lưu phiên bản công bố (một QR chung cho lô); bản trước của lô đang Cần rà lại chuyển Đã thay thế." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="406" width="320" height="120" as="geometry"/></mxCell>
<mxCell id="en" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="658.0" y="556" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x1a" value="1a. Công bố lại sau khi rút (UC-TRC-02)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="922" y="134.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e1a" value="về bước 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=12;fillColor=#f5f5f5;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="141.0" width="92" height="30" as="geometry"/></mxCell>
<mxCell id="x1b" value="1b. Bản công bố hiện hành của lô ở Cần rà lại (sau đính chính ở UC-TRC-04)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="922" y="198.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e1b" value="về bước 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=12;fillColor=#f5f5f5;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="203.0" width="92" height="30" as="geometry"/></mxCell>
<mxCell id="x4a" value="4a. Lô đã bàn giao ngoại tuyến (UC-SAL-06 nhánh 5a)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="922" y="444.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e4a" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1224" y="452.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x3a" value="3a. Hồ sơ chưa đạt (thiếu liên kết nguồn, thiếu phiếu cân, giấy tờ vùng không hợp lệ hoặc dữ liệu đổi sau rà)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;dashed=1;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="152" y="329.0" width="270" height="60" as="geometry"/></mxCell>
<mxCell id="e3a" value="về bước 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=12;fillColor=#f5f5f5;dashed=0;" vertex="1" parent="1"><mxGeometry x="42" y="336.0" width="92" height="30" as="geometry"/></mxCell>
<mxCell id="x3b" value="3b. Lô bàn giao ngoại tuyến rà không đạt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;dashed=1;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="152" y="403.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e3b" value="về bước 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=12;fillColor=#f5f5f5;dashed=0;" vertex="1" parent="1"><mxGeometry x="42" y="408.0" width="92" height="30" as="geometry"/></mxCell>
<mxCell id="x4b" value="4b. Không đủ quyền công bố." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;dashed=1;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="152" y="467.0" width="270" height="40" as="geometry"/></mxCell>
<mxCell id="e4b" value="" style="ellipse;shape=endState;html=1;fillColor=#b85450;strokeColor=#b85450;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="106" y="473.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x4c" value="4c. Nội dung tiếng Việt/tiếng Anh không khớp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;dashed=1;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="152" y="521.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e4c" value="về bước 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=12;fillColor=#f5f5f5;dashed=0;" vertex="1" parent="1"><mxGeometry x="42" y="526.0" width="92" height="30" as="geometry"/></mxCell>
<mxCell id="n22" value="Ký hiệu: ● bắt đầu; ◉ đen = kết thúc thành công; ◉ đỏ = kết thúc do lỗi; khung trắng = bước luồng chính; khung vàng (phải) = luồng thay thế; khung đỏ nét đứt (trái) = luồng ngoại lệ; “về bước N” = quay lại bước N; “về nhánh Na” = quay lại nhánh Na. Chi tiết từng nhánh ở bảng đặc tả UC." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="616" width="1264" height="40" as="geometry"/></mxCell>
