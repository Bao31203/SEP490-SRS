<mxfile host="Claude Code" agent="sdd-architecture-drawio" version="24.0.0" pages="11"><diagram id="lerd-00" name="ERD-00 Overview"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" value="" /><mxCell id="1" parent="0" value="" /><mxCell id="erd-00-note-1" value="&lt;b&gt;Diagram ID:&lt;/b&gt; DGM-LERD-00&lt;br&gt;&lt;b&gt;Name:&lt;/b&gt; Logical ERD – Overview of 53 entities by group&lt;br&gt;&lt;b&gt;Notation:&lt;/b&gt; Logical ERD, Crow's Foot (SRS level, DBMS-independent)&lt;br&gt;&lt;b&gt;Purpose:&lt;/b&gt; Map of the 53 entities in the 9 groups of SRS 3.2 and the matching detailed Logical ERD page&lt;br&gt;&lt;b&gt;Scope:&lt;/b&gt; Entity names only; the complete model with all relationships is on ERD-FULL, attributes and constraints in SRS 3.2 (group pages ERD-01 … ERD-09 belong to the SDS)&lt;br&gt;&lt;b&gt;Related SRS:&lt;/b&gt; 3.2 Data model (53 entities), OMTS SRS v5.9 (20/10/2026)&lt;br&gt;&lt;b&gt;Related use cases:&lt;/b&gt; UC-ACC-01 … UC-ADM-04 (81 UCs)&lt;br&gt;&lt;b&gt;Design decisions shown:&lt;/b&gt; Main flow: SalesOrder → HarvestEvent / LaneSegment → TraceabilityLot (1 QR) → PortWeighing → PortHandover / SaleTransaction → after-sales, finance&lt;br&gt;&lt;b&gt;Assumptions/TBD:&lt;/b&gt; Open points: SRS V.3.2" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff8e1;strokeColor=#b7a56a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="760" height="190" as="geometry" /></mxCell><mxCell id="erd-00-note-2" value="&lt;b&gt;Legend (logical ERD)&lt;/b&gt;&lt;br&gt;PK primary key (underlined) · FK foreign key (italic) · AK alternate key (unique)&lt;br&gt;FK rule: the key of the ┼ / o┼ (one) side is stored as FK on the many side; associative entities use a composite PK of two FKs&lt;br&gt;Crow's Foot: ┼ exactly one · o┼ zero or one · o&lt; zero or many · ┼&lt; one or many&lt;br&gt;Read both ways: Customer –placing→ SalesOrder = a Customer places 0..n SalesOrders; reverse: a SalesOrder is placed by exactly 1 Customer&lt;br&gt;Second line of each entity: Vietnamese name · C/I status. No data types (specified in the SDS)&lt;br&gt;Entities of other groups are repeated in full, as drawn on their own page (same colour)&lt;br&gt;C: confirmed from source · I: inferred to preserve rules&lt;br&gt;*_by attributes (recorder / approver): user who acted, no relationship drawn · Money: VND, multiples of 1,000" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff8e1;strokeColor=#b7a56a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="20" width="520" height="170" as="geometry" /></mxCell><mxCell id="erd-00-g-3" value="&lt;b&gt;Organization, identity, access control&lt;/b&gt; (6) · ERD-01" style="swimlane;html=1;startSize=30;horizontal=1;rounded=0;whiteSpace=wrap;fillColor=#eef4fb;strokeColor=#2f5f8f;swimlaneFillColor=#ffffff;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="440" height="194" as="geometry" /></mxCell><mxCell id="erd-00-ch-4" value="&lt;b&gt;Cooperative&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Oyster farming cooperative · C&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f5f8f;fontSize=11;" vertex="1" parent="erd-00-g-3"><mxGeometry x="13" y="36" width="200" height="40" as="geometry" /></mxCell><mxCell id="erd-00-ch-5" value="&lt;b&gt;Account&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;User account · C&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f5f8f;fontSize=11;" vertex="1" parent="erd-00-g-3"><mxGeometry x="227" y="36" width="200" height="40" as="geometry" /></mxCell><mxCell id="erd-00-ch-6" value="&lt;b&gt;Employee&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Employee profile · C&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f5f8f;fontSize=11;" vertex="1" parent="erd-00-g-3"><mxGeometry x="13" y="86" width="200" height="40" as="geometry" /></mxCell><mxCell id="erd-00-ch-7" value="&lt;b&gt;Role&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Role defined by the Owner · C&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f5f8f;fontSize=11;" vertex="1" parent="erd-00-g-3"><mxGeometry x="227" y="86" width="200" height="40" as="geometry" /></mxCell><mxCell id="erd-00-ch-8" value="&lt;b&gt;RolePermission&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Permission of a role on a feature · C&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f5f8f;fontSize=11;" vertex="1" parent="erd-00-g-3"><mxGeometry x="13" y="136" width="200" height="40" as="geometry" /></mxCell><mxCell id="erd-00-ch-9" value="&lt;b&gt;AccessGrant&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Role granted to an account in a zone · C&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f5f8f;fontSize=11;" vertex="1" parent="erd-00-g-3"><mxGeometry x="227" y="136" width="200" height="40" as="geometry" /></mxCell><mxCell id="erd-00-g-10" value="&lt;b&gt;Farm&lt;/b&gt; (8) · ERD-02" style="swimlane;html=1;startSize=30;horizontal=1;rounded=0;whiteSpace=wrap;fillColor=#eef8ee;strokeColor=#4a7f45;swimlaneFillColor=#ffffff;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="250" width="440" height="244" as="geometry" /></mxCell><mxCell id="erd-00-ch-11" value="&lt;b&gt;FarmingZone&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Farming zone · C&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a7f45;fontSize=11;" vertex="1" parent="erd-00-g-10"><mxGeometry x="13" y="36"