<mxCell id="n2" value="UC-CLM-04 Đánh giá hàng trả về – sơ đồ luồng" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="24" as="geometry"/></mxCell>
<mxCell id="st" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="659.0" y="60" width="26" height="26" as="geometry"/></mxCell>
<mxCell id="b1" value="1. Chủ HTX mở hàng trả; hệ thống hiện lượng thực nhận, tình trạng, nơi giữ tạm, ảnh và giao dịch gốc." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="116" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="b2" value="2. Chủ HTX đánh giá lượng có thể bán lại và lượng không bán lại được kèm căn cứ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="216" width="320" height="50" as="geometry"/></mxCell>
<mxCell id="b3" value="3. Chủ HTX đặt thời gian giữ cho phần bán lại được; hệ thống lưu đánh giá, hàng trả chuyển Đang giữ tạm → Đã đánh giá." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="296" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="b4" value="4. Hệ thống giữ phần bán lại được để gắn đơn mới (UC-SAL-03, UC-SAL-04), dùng QR cũ và cân lại ở UC-SAL-06." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="512" y="396" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="en" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="658.0" y="496" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x1a" value="1a. Chủ HTX quyết định trừ nợ hoặc hoàn tiền cho hàng trả." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="922" y="129.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e1a" value="về bước 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=12;fillColor=#f5f5f5;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="136.0" width="92" height="30" as="geometry"/></mxCell>
<mxCell id="x2a" value="2a. Một phần hàng trả không bán lại được." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="922" y="219.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e2a" value="về bước 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=12;fillColor=#f5f5f5;dashed=0;" vertex="1" parent="1"><mxGeometry x="1210" y="226.0" width="92" height="30" as="geometry"/></mxCell>
<mxCell id="x2b" value="2b. Không có phần bán lại được." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="922" y="283.0" width="270" height="40" as="geometry"/></mxCell>
<mxCell id="e2b" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1224" y="289.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x4a" value="4a. Một lần trả chia cho nhiều đơn mới." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="922" y="409.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e4a" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1224" y="417.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x4b" value="4b. Hết thời gian giữ mà phần bán lại được còn lại chưa gắn đơn mới." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="922" y="473.0" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="e4b" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1224" y="479.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="x1b" value="1b. Số tiền trừ nợ/hoàn cho hàng trả vượt phần còn được điều chỉnh của giao dịch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;dashed=1;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="152" y="129.0" width="270" height="60" as="geometry"/></mxCell>
<mxCell id="e1b" value="về nhánh 1a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=12;fillColor=#f5f5f5;dashed=0;" vertex="1" parent="1"><mxGeometry x="42" y="136.0" width="92" height="30" as="geometry"/></mxCell>
<mxCell id="x3a" value="3a. Thiếu thời gian giữ, căn cứ đánh giá, hoặc tổng lượng bán lại và tiêu hủy vượt lượng thực nhận." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;dashed=1;arcSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="152" y="309.0" width="270" height="60" as="geometry"/></mxCell>
<mxCell id="e3a" value="về bước 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;arcSize=14;fontSize=12;fillColor=#f5f5f5;dashed=0;" vertex="1" parent="1"><mxGeometry x="42" y="316.0" width="92" height="30" as="geometry"/></mxCell>
<mxCell id="n22" value="Ký hiệu: ● bắt đầu; ◉ đen = kết thúc thành công; ◉ đỏ = kết thúc do lỗi; khung trắng = bước luồng chính; khung vàng (phải) = luồng thay thế; khung đỏ nét đứt (trái) = luồng ngoại lệ; “về bước N” = quay lại bước N; “về nhánh Na” = quay lại nhánh Na. Chi tiết từng nhánh ở bảng đặc tả UC." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="557.0" width="1264" height="40" as="geometry"/></mxCell>
